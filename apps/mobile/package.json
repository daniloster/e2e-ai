{
  "name": "pocket-notes-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:build:dev": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:build:e2e": "cd android && E2E_BUILD=1 ./gradlew assembleE2e",
    "ios": "react-native run-ios",
    "ios:sim": "scripts/ios-sim.sh",
    "lint": "cd ../.. && node node_modules/eslint/bin/eslint.js apps/mobile",
    "start": "react-native start --port 8093",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pn/core": "file:../../apps-modules/core",
    "@pn/design-tokens": "file:../../apps-modules/design-tokens",
    "@pn/i18n": "file:../../apps-modules/i18n",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-firebase/analytics": "27.1.0",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/crashlytics": "27.1.0",
    "expo": "58.0.23",
    "expo-asset": "58.0.20",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-secure-store": "58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bootsplash": "7.3.5",
    "react-native-device-info": "15.0.2",
    "react-native-safe-area-context": "5.11.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.13",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "babel-preset-expo": "58.0.24",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
