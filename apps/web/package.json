{
  "name": "@pn/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev:https": "node https/gen-cert.mjs",
    "dev:https": "node https/serve.mjs dist 8443",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-cdn.mjs && node scripts/write-hosting-files.mjs && node scripts/site-budget.mjs",
    "check:budget": "node scripts/site-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run --coverage --coverage.include='src/**/*.{ts,tsx}' --coverage.include='vite/**/*.ts' --coverage.exclude='**/*.test.*' --coverage.exclude=src/vite-env.d.ts --coverage.thresholds.lines=80",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "e2e:site": "playwright test --project site",
    "deploy:prod": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@pn/core": "*",
    "@pn/design-tokens": "*",
    "@pn/i18n": "*",
    "firebase": "12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "vite": "8.3.3",
    "wrangler": "4.145.0"
  }
}
