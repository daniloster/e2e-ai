{
  "name": "pocket-notes",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps-modules/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run --config vitest.workspace.ts --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "brand": "npm run brand -w @pn/brand --",
    "build": "if ls packages/*/package.json apps/web/package.json 2>/dev/null | grep -q .; then npm run build --workspaces --if-present; fi",
    "web:build": "npm run build --prefix apps/web",
    "web:serve": "npm run dev:https --prefix apps/web",
    "mobile:android:build:dev": "npm run android:build:dev --prefix apps/mobile",
    "mobile:android:install": "adb install -r ./apps/mobile/android/app/build/outputs/apk/debug/app-debug.apk && adb reverse tcp:8093 tcp:8093",
    "mobile:android:deep-link": "./scripts/deep-link.sh android",
    "mobile:ios:deep-link": "./scripts/deep-link.sh ios",
    "api": "node apps-modules/fixture-api/src/main.ts",
    "notes:web": "npm run dev --prefix apps/web -- --port 5180 --strictPort",
    "e2e:ai:doctor": "node packages/e2e-ai-cli/src/cli.ts doctor",
    "e2e:ai:web": "node packages/e2e-ai-cli/src/cli.ts run --target web",
    "e2e:ai:web:replay": "node packages/e2e-ai-cli/src/cli.ts run --target web --replay",
    "e2e:ai:ios": "node packages/e2e-ai-cli/src/cli.ts run --target ios",
    "e2e:ai:ios:replay": "node packages/e2e-ai-cli/src/cli.ts run --target ios --replay",
    "e2e:ai:report": "node packages/e2e-ai-cli/src/cli.ts report",
    "e2e:ai": "node packages/e2e-ai-cli/src/cli.ts",
    "e2e:ai:benchmark": "node packages/e2e-ai-cli/src/cli.ts run --target web --benchmark",
    "e2e:cloud:check": "node scripts/fake-cloud-check.ts"
  },
  "devDependencies": {
    "@pn/brand": "*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
