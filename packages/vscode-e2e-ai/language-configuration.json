{
  "comments": {
    "lineComment": "# "
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "<", "close": ">" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "folding": {
    "offSide": true
  },
  "wordPattern": "(#|@)?[\\w-]+",
  "onEnterRules": [
    {
      "beforeText": "^\\s*(Feature|Rule|Background|Scenario|Scenario Outline|Examples|Routine):.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*each\\s+\\$\\{.*\\}\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
