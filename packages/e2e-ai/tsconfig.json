{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "target": "ES2022",
    "types": [
      "node"
    ],
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
